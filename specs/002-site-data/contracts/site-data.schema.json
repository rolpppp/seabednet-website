{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seabed-lens/site-data.schema.json",
  "title": "SeaBed Lens site data",
  "description": "Every number the site shows, with provenance. Generated by scripts/export_site_data.py; never edited by hand.",
  "type": "object",
  "required": ["schema_version", "generated_at", "generator_version", "thesis_repo_commit", "headline", "tta", "benchmarks", "config_changes", "variants", "classes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generator_version": { "type": "string" },
    "thesis_repo_commit": { "type": ["string", "null"] },

    "headline": {
      "type": "object",
      "description": "B0 (VITL_ACC) on the held-out JODD test split, mean over 3 seeds.",
      "required": ["model", "box", "mask"],
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/ModelRef" },
        "box": { "$ref": "#/$defs/CocoMetrics" },
        "mask": { "$ref": "#/$defs/CocoMetrics" }
      }
    },

    "tta": {
      "type": "object",
      "description": "Flip test-time augmentation. Always shown apart from model numbers.",
      "required": ["box", "mask"],
      "additionalProperties": false,
      "properties": {
        "box": { "type": "object", "required": ["AP", "AP50"], "properties": { "AP": { "$ref": "#/$defs/Metric" }, "AP50": { "$ref": "#/$defs/Metric" } } },
        "mask": { "type": "object", "required": ["AP", "AP50"], "properties": { "AP": { "$ref": "#/$defs/Metric" }, "AP50": { "$ref": "#/$defs/Metric" } } }
      }
    },

    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["benchmark", "task", "protocol", "ours", "ours_params_m", "best_published", "notes"],
        "additionalProperties": false,
        "properties": {
          "benchmark": { "enum": ["RUOD", "UIIS10K"] },
          "task": { "enum": ["box", "mask"] },
          "protocol": { "type": "string", "examples": ["UDINO", "EDB-Net", "official"] },
          "ours": { "$ref": "#/$defs/Metric" },
          "ours_params_m": { "type": "number" },
          "best_published": {
            "type": "object",
            "required": ["model", "value", "params_m", "citation"],
            "properties": {
              "model": { "type": "string" },
              "value": { "type": "number" },
              "unit": { "enum": ["fraction", "percent"] },
              "params_m": { "type": "number" },
              "citation": { "type": "string" }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },

    "config_changes": {
      "type": "array",
      "description": "One row per single change from the baseline. The baseline row comes first.",
      "items": {
        "type": "object",
        "required": ["id", "change", "split", "n", "delta_box_ap", "delta_mask_ap", "reading", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "change": { "type": "string" },
          "is_baseline": { "type": "boolean" },
          "split": { "enum": ["test", "val"] },
          "n": { "type": ["integer", "null"], "minimum": 1 },
          "delta_box_ap": { "type": ["number", "null"] },
          "delta_mask_ap": { "type": ["number", "null"] },
          "reading": { "enum": ["baseline", "improved", "worse", "no_detectable_difference", "dropped", "pending_export"] },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "Finding IDs, e.g. F29" },
          "source": { "$ref": "#/$defs/Source" }
        }
      }
    },

    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "what_changed", "component", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "examples": ["b0", "vitb", "c2f_vitb_cvxmos", "c2f_mdual", "vit_only"] },
          "name": { "type": "string" },
          "what_changed": { "type": "string" },
          "component": { "type": "string", "examples": ["all", "hybrid backbone", "colour processing", "fusion design", "backbone scale", "model history"] },
          "status": { "enum": ["trained", "pending"] },
          "checkpoint_id": { "type": ["string", "null"] },
          "test_box_ap": { "$ref": "#/$defs/MetricOrNull" },
          "test_mask_ap": { "$ref": "#/$defs/MetricOrNull" }
        }
      }
    },

    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "frequency_rank"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "frequency_rank": { "type": "integer", "minimum": 1, "description": "1 = most instances; drives overlay colour order (DS §8)" },
          "instances": { "type": ["integer", "null"] },
          "reviewed_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },

    "object_size": {
      "type": "object",
      "description": "Derived from headline for the size chart; duplicates no source.",
      "properties": {
        "bins": { "const": "COCO: S < 32^2, M < 96^2, L >= 96^2 px" }
      }
    }
  },

  "$defs": {
    "Source": {
      "type": "object",
      "required": ["file", "mtime"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "description": "Path relative to the thesis repo" },
        "mtime": { "type": "string", "format": "date-time" },
        "locator": { "type": "string", "description": "JSON key path or Markdown table heading" }
      }
    },
    "Metric": {
      "type": "object",
      "required": ["value", "unit", "split", "n", "runs", "source"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "unit": { "enum": ["fraction", "percent"] },
        "split": { "enum": ["test", "val"] },
        "n": { "type": "integer", "minimum": 1 },
        "runs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sd": { "type": ["number", "null"], "description": "Sample standard deviation over seeds when n > 1" },
        "per_seed": { "type": "array", "items": { "type": "number" } },
        "tta": { "type": "boolean", "default": false },
        "source": { "$ref": "#/$defs/Source" }
      }
    },
    "MetricOrNull": { "oneOf": [ { "$ref": "#/$defs/Metric" }, { "type": "null" } ] },
    "CocoMetrics": {
      "type": "object",
      "required": ["AP", "AP50", "AP_S", "AP_M", "AP_L"],
      "additionalProperties": false,
      "properties": {
        "AP": { "$ref": "#/$defs/Metric" },
        "AP50": { "$ref": "#/$defs/Metric" },
        "AP75": { "$ref": "#/$defs/MetricOrNull" },
        "AP_S": { "$ref": "#/$defs/Metric" },
        "AP_M": { "$ref": "#/$defs/Metric" },
        "AP_L": { "$ref": "#/$defs/Metric" }
      }
    },
    "ModelRef": {
      "type": "object",
      "required": ["id", "name", "config", "params_m"],
      "properties": {
        "id": { "const": "b0" },
        "name": { "type": "string", "examples": ["Full model (B0)"] },
        "config": { "type": "string", "examples": ["VITL_ACC"] },
        "params_m": { "type": "number", "examples": [352] }
      }
    }
  }
}
