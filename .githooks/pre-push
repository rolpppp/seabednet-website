#!/bin/sh
# Git pre-push hook (enable once with: git config core.hooksPath .githooks)
# Refuses to push any commit whose author or committer looks like an AI agent, or whose message
# still carries an AI co-author trailer. This is the last check before anything reaches GitHub.

z40=0000000000000000000000000000000000000000
bad=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac          # branch deletion: nothing to check
  if [ "$remote_sha" = "$z40" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    range="$local_sha --not --remotes"                          # new branch: only commits not on any remote
  else
    range="$remote_sha..$local_sha"
  fi

  # shellcheck disable=SC2086
  offenders=$(git log --format='%H%x09%an <%ae>%x09%cn <%ce>' $range | grep -Ei '(claude|anthropic|noreply@anthropic\.com)')
  if [ -n "$offenders" ]; then
    echo "pre-push: commits authored or committed by an AI identity:" >&2
    echo "$offenders" >&2
    bad=1
  fi

  # shellcheck disable=SC2086
  for sha in $(git rev-list $range); do
    if git log -1 --format=%B "$sha" | grep -Eiq '^[[:space:]]*(co-authored-by:.*(claude|anthropic)|claude-session:)'; then
      echo "pre-push: $sha has an AI co-author or session trailer." >&2
      bad=1
    fi
  done
done

if [ "$bad" -ne 0 ]; then
  echo "pre-push: push refused. Reword with 'git commit --amend' or 'git rebase -i', and check 'git config user.email'." >&2
  exit 1
fi
exit 0
