#!/bin/sh
# Git commit-msg hook (enable once with: sh setup/install-guardrails.sh, or git config core.hooksPath .githooks)
# 1. Removes AI attribution lines from the commit message, so a message copied from an agent can never credit Claude.
# 2. Notes (without blocking) when the first line doesn't follow '<feat|fix|refactor|del>: <message>'.

msg_file="$1"
[ -f "$msg_file" ] || exit 0

pattern='^[[:space:]]*(co-authored-by:.*(claude|anthropic)|claude-session:|.*generated with \[?claude( code)?\]?|.*🤖 generated with)'

if grep -Eiq "$pattern" "$msg_file"; then
  tmp="$msg_file.tmp.$$"
  grep -Eiv "$pattern" "$msg_file" > "$tmp"
  # drop trailing blank lines left behind
  awk '{a[NR]=$0} END{n=NR; while(n>0 && a[n] ~ /^[[:space:]]*$/) n--; for(i=1;i<=n;i++) print a[i]}' "$tmp" > "$msg_file"
  rm -f "$tmp"
  echo "commit-msg: removed AI attribution lines from the commit message." >&2
fi

first_line=$(grep -v '^#' "$msg_file" | head -n 1)
case "$first_line" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) ;;
  *)
    if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|refactor|del): [^ ].{0,64}$'; then
      echo "commit-msg: note - the first line doesn't follow '<feat|fix|refactor|del>: <message>' (72 chars max)." >&2
      echo "            Commit kept. Amend with: git commit --amend" >&2
    fi ;;
esac
exit 0
