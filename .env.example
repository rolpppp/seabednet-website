# Copy this file to .env and fill it in. The real .env is git-ignored; never commit it.

# Path to the read-only thesis repository. Agents and scripts only read from it. Never hard-code it.
SEABEDNET_REPO=

# Base URL of the FastAPI backend, for example http://localhost:8000
API_BASE_URL=

# Show the bundled sample images on the Try it page. Keep false until samples are cleared for use.
SAMPLES_ENABLED=false

# How long uploaded images are kept, in hours. Undecided (README open question 4), so left blank on purpose.
UPLOAD_RETENTION_HOURS=
